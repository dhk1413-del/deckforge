{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "深蓝光感科技发布风：深空底 + 冷蓝渐变，发布会/技术方案气质。",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.91,
          0.933,
          0.969
        ],
        "hex": "#e8eef7"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.561,
          0.639,
          0.749
        ],
        "hex": "#8fa3bf"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.231,
          0.51,
          0.965
        ],
        "hex": "#3b82f6"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.043,
          0.071,
          0.125
        ],
        "hex": "#0b1220"
      }
    },
    "bg": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.043,
          0.071,
          0.125
        ],
        "hex": "#0b1220"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.067,
          0.11,
          0.18
        ],
        "hex": "#111c2e"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.231,
          0.51,
          0.965
        ],
        "hex": "#3b82f6"
      }
    },
    "accent-2": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.133,
          0.827,
          0.933
        ],
        "hex": "#22d3ee"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.91,
          0.933,
          0.969
        ],
        "hex": "#e8eef7"
      }
    },
    "ink-sub": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.561,
          0.639,
          0.749
        ],
        "hex": "#8fa3bf"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "page-margin": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Source Han Sans SC",
        "fontSize": {
          "value": 3.5,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Source Han Sans SC",
        "fontSize": {
          "value": 2,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Source Han Sans SC",
        "fontSize": {
          "value": 1.25,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Source Han Sans SC",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "num": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontSize": {
          "value": 2.5,
          "unit": "rem"
        },
        "fontWeight": 700
      }
    }
  }
}
