# SlideCraft 密钥模板 —— 复制为 .env 后填写；不要提交到仓库
# ⚠️ 密钥红线：这个文件（.env / config/.env）已被 .gitignore 排除；提交与推送前还会由
#    tools/check_no_secrets.py 强制拦截（pre-commit / pre-push 钩子）。界面上填的 key 存数据库，同样不入库。
# 放哪都行：**工作区根目录**（…/智能PPT生成工作台/.env）或 **config/ 目录**（config/.env，优先）
# 留空也能启动：生图/文案相关动作会提示「模型未配置」，其余功能照常可用（降级，见 §7.4）
# 更省事的办法：直接在界面里填 → http://127.0.0.1:8640/#/settings（热加载，无需重启，回显掩码）

# 注意：下面两行只是「给外部工具参考」的写法。SlideCraft 自身**不读环境变量代理**——
# 它按 config/providers.yaml 的 network.mode（http_proxy / tun / none）显式决定：
# GuaiHub 走代理、阿里百炼与 DeepSeek 直连。要改代理地址请改 providers.yaml 或界面设置。
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
# ⚠️ 若用 TUN 模式客户端（如 nano）接管流量：把 network.mode 改为 tun，并把上面两行**注释掉**

# 生图 —— GuaiHub（需代理）与阿里百炼（直连），可只填一家
GUAIHUB_API_KEY=
DASHSCOPE_API_KEY=

# 文本（文案梳理，建议必填）
DEEPSEEK_API_KEY=

# 运行参数（可选）
#   DECKFORGE_PORT —— 后端端口，由 server/run.sh 读取（默认 8640）
#   DECKFORGE_DATA —— 数据目录（数据库/上传件/导出件），相对工作区根；改后需重启后端
DECKFORGE_PORT=8640
DECKFORGE_DATA=./data
